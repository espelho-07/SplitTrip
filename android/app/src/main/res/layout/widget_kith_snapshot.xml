<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_snapshot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- SIGNED-IN CONTENT -->
    <LinearLayout
        android:id="@+id/layout_snapshot_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="KITH · THIS MONTH"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_snapshot_quick_add_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_pill_button"
                android:padding="5dp"
                android:src="@drawable/ic_widget_add"
                android:contentDescription="Add Expense" />
        </LinearLayout>

        <!-- Big Amount -->
        <TextView
            android:id="@+id/txt_snapshot_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="₹0"
            android:textColor="@color/widget_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle Context -->
        <TextView
            android:id="@+id/txt_snapshot_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Spent this month"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Budget Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_snapshot_budget"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- Budget Footer Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_snapshot_budget_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Budget: ₹20,000"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_snapshot_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹7,550 left"
                android:textColor="@color/kith_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- SIGNED-OUT STATE -->
    <LinearLayout
        android:id="@+id/layout_snapshot_signed_out"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kith"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Sign in to see your money"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_snapshot_signin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_pill_button"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Sign In"
            android:textColor="@color/widget_text_on_emerald"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
