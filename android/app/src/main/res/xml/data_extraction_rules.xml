<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction Rules (Android 12+, API 31+)
  Configures cloud backup and device-to-device migration rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="kith_fcm_token" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="database" path="kith_production_v2.db-wal" />
        <exclude domain="database" path="kith_production_v2.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="sharedpref" path="kith_fcm_token" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="database" path="kith_production_v2.db-wal" />
        <exclude domain="database" path="kith_production_v2.db-shm" />
    </device-transfer>
</data-extraction-rules>
