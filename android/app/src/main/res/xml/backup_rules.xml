<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup Rules (Android 6.0-11, API 23-31)
  Safely backs up user settings and recovery vaults across reinstalls
  while excluding hardware-bound keystore secrets and volatile SQLite WAL files.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="kith_fcm_token" />
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="database" path="kith_production_v2.db" />
    <exclude domain="database" path="kith_production_v2.db-wal" />
    <exclude domain="database" path="kith_production_v2.db-shm" />
</full-backup-content>
