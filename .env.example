# Kith — Root Environment Configuration Example
# Copy this file to .env or server/.env when running the backend or Supabase functions.
# NEVER commit actual secrets or real API keys to GitHub!

# ─── IPO Data Providers (Server-Side Secrets ONLY) ───────────────────────────
# Primary Provider: IPO Guru API (ipoguru.in)
# Request a free API key at: ipoguru.in@gmail.com (300 req/day, 15 req/min)
# Tomorrow when adding the key, set: IPO_GURU_API_KEY=<real-secret>
IPO_GURU_API_KEY=your_ipo_guru_api_key_here

# Backup Provider: FinAPI (finapi.in / finapi.co)
# Used automatically as fallback when IPO Guru key is unconfigured or temporarily unavailable.
FINAPI_API_KEY=your_finapi_api_key_here

# ─── Firebase Cloud Messaging (Push Notifications) ─────────────────────────
FIREBASE_PROJECT_ID=amazing-pipe-484506-t8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@amazing-pipe-484506-t8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─── Backend Server ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
