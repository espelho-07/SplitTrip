# Kith / SplitTrip Environment Configuration Template
# Copy this file to .env or inject values via CI/CD secret manager.

# Backend API Configuration
PORT=3000
NODE_ENV=staging # local | staging | production
CORS_ORIGIN=https://kith.app,http://localhost:3000

# Security & Session Secrets
SESSION_SECRET=replace_with_cryptographically_secure_random_64_char_hex_secret

# Storage Configuration
DATA_STORAGE_DIR=./data_storage

# Notification & Cloud Messaging (Optional / Future)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
