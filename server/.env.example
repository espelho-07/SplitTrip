# Kith Server — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Firebase Cloud Messaging (FCM) Push Notifications ─────────────────────
# Required for push notifications to backgrounded/terminated devices.
# If not set, FCM push is silently disabled (WebSocket still works for foreground).
#
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
#
FIREBASE_PROJECT_ID=amazing-pipe-484506-t8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@amazing-pipe-484506-t8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── IPO Data — IPO Guru API ─────────────────────────────────────────────────
# Request a free API key at: ipoguru.in@gmail.com (300 req/day, 15 req/min)
# If not set, the backend returns the static curated fallback catalog.
IPO_GURU_API_KEY=your_ipo_guru_api_key_here
