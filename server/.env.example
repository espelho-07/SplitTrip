# Kith Backend Environment Configuration
PORT=3000
NODE_ENV=staging
CORS_ORIGIN=https://kith.app,http://localhost:3000
SESSION_SECRET=replace_with_cryptographically_secure_random_64_char_hex_secret
DATA_STORAGE_DIR=./data_storage

# PostgreSQL / Supabase Connection URI (Render Staging / Production)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
