# Kith Server — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Firebase Cloud Messaging (FCM) Push Notifications ─────────────────────
# Target Firebase project matching Android google-services.json: kith-7c88f
# Required for push notifications to backgrounded/terminated devices.
# If not set, FCM push is silently disabled (WebSocket still works for foreground).
#
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
#
FIREBASE_PROJECT_ID=kith-7c88f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@kith-7c88f.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── IPO Data Providers (Server-Side Secrets ONLY) ───────────────────────────
# Primary Provider: IPO Guru API (ipoguru.in)
# Request a free API key at: ipoguru.in@gmail.com (300 req/day, 15 req/min)
# Set: IPO_GURU_API_KEY=<real-secret>
IPO_GURU_API_KEY=your_ipo_guru_api_key_here

# Backup Provider: FinAPI (finapi.in / finapi.co)
# Used automatically as fallback when IPO Guru key is unconfigured or temporarily unavailable.
FINAPI_API_KEY=your_finapi_api_key_here
